# ============================================================
# OrbitalQuery analysis service — environment configuration
# ============================================================
# All settings are OPTIONAL with sane defaults. There are no secrets.
# Cloud Run: set these via `gcloud run deploy --set-env-vars` (see
# docs/DEPLOYMENT.md). Do NOT commit real .env files.

# --- Planetary Computer endpoints (public, no key) -------------
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# --- CORS -------------------------------------------------------
# Comma-separated list of origins allowed to call this service directly.
# "*" is fine for local dev; in production set your Vercel origin:
#   ALLOWED_ORIGINS=https://orbitalquery.vercel.app
# (The browser normally talks to Next.js, which proxies to this service,
#  so this only matters if you ever call it from the client.)
ALLOWED_ORIGINS=*

# --- Processing guards ------------------------------------------
# Max AOI area accepted, km² (larger requests are rejected with a clear error)
MAX_AOI_KM2=25000
# Pixel budget per band (memory bound): ~1.2M px ≈ 1096×1096
TARGET_PIXELS=1200000
# Max change regions in the response GeoJSON
MAX_REGIONS=250

# --- Analysis defaults ------------------------------------------
SIMPLIFY_TOLERANCE_M=10

# --- Networking -------------------------------------------------
HTTP_CONNECT_TIMEOUT_S=5
HTTP_READ_TIMEOUT_S=25
GDAL_HTTP_TIMEOUT_S=30
