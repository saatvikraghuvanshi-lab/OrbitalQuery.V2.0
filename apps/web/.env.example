# ============================================================
# OrbitalQuery V2 — apps/web environment configuration
# ============================================================
# LOCAL DEVELOPMENT: copy this file to .env.local and fill values.
# PRODUCTION (Vercel): set these in Vercel Project Settings → Environment
# Variables. ANALYSIS_SERVICE_URL MUST be the real Cloud Run URL there —
# never leave it pointing at localhost in production.

# --- Planetary Computer STAC API -------------------------------
# Public STAC endpoint for scene discovery. No API key required.
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# --- Python analysis service (FastAPI on Cloud Run) ------------
# Local: the FastAPI dev server.
# Production: the deployed Cloud Run service URL, e.g.
#   https://orbitalquery-analysis-xxxx-uc.a.run.app
# Server-side only. NEVER prefix this with NEXT_PUBLIC_ — the browser must
# not learn the analysis service URL.
ANALYSIS_SERVICE_URL=http://localhost:8000

# --- Public app URL (used for canonical links / metadata) ------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional timeouts (milliseconds, server-side) -------------
# STAC search timeout. Default 12000.
STAC_TIMEOUT_MS=12000
# Analysis proxy timeout. Default 60000. Cloud Run cold starts can take
# 15-30s, so do not set this below 45000 in production.
ANALYSIS_TIMEOUT_MS=60000
